# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/magic_ai

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_256_bit_secret
JWT_EXPIRES_IN=7d

# ─── App ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── GitHub OAuth ───────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback

# ─── GitLab OAuth ───────────────────────────────────────────
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK_URL=http://localhost:4000/api/gitlab/callback

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:5173/payment?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/payment

# ─── Razorpay ───────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
